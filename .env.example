# Copia este archivo como .env.local y rellena con los datos de tu proyecto de Supabase
# (Dashboard → Project Settings → API Keys). La clave "publishable" es pública: va al navegador.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Public address once it is online, e.g. https://railodex.app (for email and QR links).
# Leave it empty while working locally.
NEXT_PUBLIC_SITE_URL=
